# {{ vm_name }}

http:
  routers:
    {{ vm_name }}:
      rule: "Host(`{{ dns_name }}`)"
      entryPoints:
        - websecure
      service: "{{ vm_name }}"
      tls: {}

  services:
    {{ vm_name }}:
      loadBalancer:
        servers:
          - url: "{{ service_scheme | default('http') }}://{{ vm_ip }}:{{ service_port }}"